# 对外端口
WEB_PORT=5000

# 会话签名 + 主机凭据加密密钥（务必自定义，且部署后不要随意变更）
SECRET_KEY=please-change-this-secret-key

# 初始化管理员账号（仅首次启动生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SSH 参数
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=60
# 会话最长存活秒数，0 表示不限制
SSH_MAX_SESSION_SECONDS=0

# 审计日志最大保留条数
MAX_AUDIT_LOGS=5000
